# Copie ce fichier en .env (jamais committé) et renseigne ta clé.
# La même clé est à mettre en secret GitHub Actions sous le nom ANTHROPIC_API_KEY.

# Clé API Anthropic (https://console.anthropic.com/ → API Keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (Optionnel) Modèles utilisés par le pipeline de blog.
# Par défaut : génération et contrôle sur claude-sonnet-4-6.
# ARTICLE_GEN_MODEL=claude-sonnet-4-6
# ARTICLE_REVIEW_MODEL=claude-sonnet-4-6
